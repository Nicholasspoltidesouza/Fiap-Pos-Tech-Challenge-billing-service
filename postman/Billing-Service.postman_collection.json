{
  "info": {
    "name": "Billing Service",
    "description": "Collection for FIAP billing-service (budgets and Mercado Pago payments)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "orcamentoId",
      "value": ""
    },
    {
      "key": "pagamentoId",
      "value": ""
    },
    {
      "key": "ordemServicoId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Get Orcamento by Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orcamentos/{{orcamentoId}}"
      }
    },
    {
      "name": "Get Orcamentos by Ordem Servico",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orcamentos/por-ordem/{{ordemServicoId}}"
      }
    },
    {
      "name": "Create Checkout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/pagamentos/{{orcamentoId}}/checkout"
      }
    },
    {
      "name": "Get Pagamento by Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pagamentos/{{pagamentoId}}"
      }
    },
    {
      "name": "Mercado Pago Webhook",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"123456\",\n  \"type\": \"payment\",\n  \"action\": \"payment.updated\",\n  \"data\": {\n    \"id\": \"mock-pref-or-payment-id\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/pagamentos/webhook"
      }
    }
  ]
}
